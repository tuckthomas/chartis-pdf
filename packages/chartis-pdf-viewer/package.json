{
  "name": "@tuckthomas/chartis-pdf-viewer",
  "version": "1.0.0",
  "description": "Browser-based PDF viewer and editor React component",
  "main": "./dist/chartis-pdf-viewer.umd.js",
  "module": "./dist/chartis-pdf-viewer.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/chartis-pdf-viewer.es.js",
      "require": "./dist/chartis-pdf-viewer.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}